# ArduPilot SITL defaults for MRS UAV simulation (ArduCopter, Quad X)
#
# Loaded per SITL instance with --defaults. MAVLink sysid is set per instance
# with the --sysid command line option.

# The MRS Gazebo worlds run physics at 200 Hz (max_step_size 0.005), so the
# FDM JSON (and the gyro samples it carries) arrives at ~200 Hz. The default
# 400 Hz main loop would reject that as "Gyro rate too slow" (PreArm failure)
# and report "Main loop slow", so run the SITL scheduler at 100 Hz.
SCHED_LOOP_RATE 100

# Vehicle frame: Quad, X motor layout. The MRS x500 template propeller
# order matches the ArduCopter Quad X motor order
# (ch1=front-right CCW, ch2=rear-left CCW, ch3=front-left CW, ch4=rear-right CW)
FRAME_CLASS 1
FRAME_TYPE 1

# Guided mode: accept thrust as sent by the companion computer
# (required by the mrs_uav_ardupilot_api attitude/thrust setpoints)
GUID_OPTIONS 8

# Yaw fusion: heading fusion at ALL times (EK3_MAG_CAL=2), never the 3-axis
# mag fusion. With the copter default (3) the EKF performs a mid-air yaw
# RESET when the mag field estimate converges (~8-11 s after liftoff here),
# which every run maps into the same crash: yaw reference jumps ~2 rad,
# the guided attitude loop slams the trim, the MRS outer loop follows a
# rotated state estimate. The simulated compass is perfect, so heading
# fusion is all that is needed and it is continuous at all times.
EK3_MAG_CAL 2

# Motor PWM range, matches the servo_min/servo_max range expected by the
# ArduPilotPlugin control channels in the Gazebo model
MOT_PWM_MIN 1100
MOT_PWM_MAX 1900

# Linear thrust->pwm mapping for MRS offboard control.
# MRS commands a force-fraction through SET_ATTITUDE_TARGET (GUID_OPTIONS=8
# thrust-as-thrust). ArduPilot's default mixer (SPIN_MIN=0.15, SPIN_ARM=0.10,
# THST_EXPO=0.65) pushes the actuator floor well above idle - a small 0.2
# thrust command then maps to a pwm high enough to produce thrust above the
# motor cutoff (the "thrust over cutoff at 0.2 thrust" behavior). Setting
# these to zero makes pwm = PWM_MIN + thrust*(PWM_MAX-PWM_MIN) exactly linear
# with a true zero at idle (motors stop at thrust 0), which matches both the
# MRS a/b thrust curve and the ArduPilotPlugin pwm->velocity mapping.
MOT_SPIN_MIN 0
MOT_SPIN_ARM 0
MOT_THST_EXPO 0

# Simulated battery: analog voltage & current monitor so that MAVROS
# reports battery state
BATT_MONITOR 4

# Offboard-style control hygiene (see mrs_uav_ardupilot_api README)
# DISARM_DELAY must be > 0: with 0 the FCU auto-disarms the moment its land
# detector latches during the MRS output-enable / spool-up race (seen live:
# armed -> pwm 1184 -> auto-disarm 0.12 s later). 10 s is the ArduPilot
# default and comfortably covers the MRS LandoffTracker spool-up.
DISARM_DELAY 10 # auto-disarm 10 s after landing detection (AP default)
FS_THR_ENABLE 0 # no radio in SITL, do not fight offboard control with throttle failsafe

# The JSON FDM backend provides GPS, magnetometer and barometer data.
# No additional simulation parameters are required.
