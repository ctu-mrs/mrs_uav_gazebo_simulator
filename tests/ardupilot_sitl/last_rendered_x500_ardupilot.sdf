      <!-- GPS mount {-->
      <link name="gps_mount_link">
    <inertial>
    <mass>0.001</mass>
    <inertia>
      <ixx>1e-6</ixx>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyy>1e-6</iyy>
      <iyz>0</iyz>
      <izz>1e-6</izz>
    </inertia>
  </inertial>
    <pose>0 0 0 0 0 1.5707963267948966</pose>
    <visual name="gps_mount_visual">
    <pose>0 0 0 0 0 0</pose>
    <geometry>
      <mesh>
        <uri>model://mrs_robots_description/meshes/x500v2/gps_mount_mesh_file.stl</uri>
        <scale>1 1 1</scale>
      </mesh>
    </geometry>
    <material>
      <script>
        <name>Gazebo/Grey</name>
        <uri>file://media/materials/scripts/gazebo.material</uri>
      </script>
    </material>
  </visual>
  </link>
  <joint name="gps_mount_joint" type="fixed">
    <child>gps_mount_link</child>
    <parent>base_link</parent>
  </joint>
